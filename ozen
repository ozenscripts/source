# =========================================================
# 2. GRANT ACCESS
# =========================================================

@bot.command()
async def grantaccess(ctx, member: discord.Member):
    if ctx.author.id != OWNER_ID:
        await ctx.send(
            "❌ Only the **sᴘᴇᴇᴅᴏ bot owner** can use this command."
        )
        return

    if member.id not in granted_users:
        granted_users.append(member.id)
        save_access()

    await ctx.send(
        f"👑 {member.mention} now has access to **all sᴘᴇᴇᴅᴏ commands**."
    )


# =========================================================
# 3. REVOKE ACCESS
# =========================================================

@bot.command()
async def revokeaccess(ctx, member: discord.Member):
    if ctx.author.id != OWNER_ID:
        await ctx.send(
            "❌ Only the bot owner can use this command."
        )
        return

    if member.id in granted_users:
        granted_users.remove(member.id)
        save_access()

        await ctx.send(
            f"🔒 Removed sᴘᴇᴇᴅᴏ access from {member.mention}."
        )
    else:
        await ctx.send("❌ That user doesn't have granted access.")


