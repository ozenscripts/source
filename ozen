# =========================================================
# ACCESS SYSTEM
# =========================================================

def load_access():
    if not os.path.exists(ACCESS_FILE):
        return []

    try:
        with open(ACCESS_FILE, "r") as file:
            return json.load(file)
    except:
        return []


def save_access():
    with open(ACCESS_FILE, "w") as file:
        json.dump(granted_users, file, indent=4)


granted_users = load_access()


def has_access(member):
    if member.id == OWNER_ID:
        return True

    if member.id in granted_users:
        return True

    return member.guild_permissions.administrator


async def access_check(ctx):
    if not has_access(ctx.author):
        await ctx.send(
            "❌ You need the **Administrator** permission to use sᴘᴇᴇᴅᴏ."
        )
        return False

    return True


