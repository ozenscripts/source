# =========================================================
# 12. TIMEOUT
# =========================================================

@bot.command()
async def timeout(ctx, member: discord.Member, minutes: int):
    if not await access_check(ctx):
        return

    if minutes < 1 or minutes > 40320:
        await ctx.send(
            "❌ Timeout must be between 1 and 40320 minutes."
        )
        return

    duration = discord.utils.utcnow() + discord.timedelta(
        minutes=minutes
    )

    await member.timeout(
        duration - discord.utils.utcnow(),
        reason="sᴘᴇᴇᴅᴏ timeout"
    )

    await ctx.send(
        f"⏱️ {member.mention} timed out for `{minutes}` minutes."
    )


